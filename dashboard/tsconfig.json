{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true, "types": ["vite/client", "node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["components/**/*.tsx", "vite.config.ts"]
}
