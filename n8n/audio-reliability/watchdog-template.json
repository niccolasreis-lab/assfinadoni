      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "url": "={{ '__N8N_ORIGIN__/api/v1/executions/' + encodeURIComponent($('Receber acompanhamento').first().json.executionId) + '?includeData=true' }}",
