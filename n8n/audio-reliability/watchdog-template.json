    {
      "id": "461ece21-3673-44b7-82ca-6261e4964760",
      "name": "Decidir aviso do áudio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "// Only inspect the single parent execution supplied by the finance workflow.\nconst ctx = $('Receber acompanhamento').first().json;\nconst response = $input.first().json;\nconst statusCode = Number(response.statusCode || 200);\nconst execution = response.body || response;\nif (statusCode !== 200 || execution.workflowId !== ctx.workflowId || String(execution.id) !== String(ctx.executionId)) return [];\nconst runs = execution.data?.resultData?.runData || {};\nconst delivered = (runs['Responder WhatsApp'] || []).some(run => !run.error && run.data?.main?.[0]?.some(item => item.json?.key?.id));\nif (delivered || ['success', 'canceled'].includes(execution.status)) return [];\n// Never claim a financial operation failed: a write may already have committed.\nconst failed = ['error', 'crashed'].includes(execution.status);\nconst atFinalCheck = $('Checagem final?').isExecuted;\nif (!failed && atFinalCheck) return [];\nreturn [{json:{...ctx,kind:failed?'failure':'progress',replyText:failed\n ? 'Não consegui concluir a resposta ao seu áudio. Antes de reenviar um pagamento, confira os lançamentos para evitar duplicidade. Se preferir, escreva o pedido em texto.'\n : 'Recebi seu áudio e ainda estou processando. Está demorando mais que o esperado; vou continuar tentando e avisar se não conseguir.'}}];\n"
      }
    },
    {
      "id": "9dd5d4f4-86cb-4cd5-af85-e16ec1111b5d",
      "name": "Enviar aviso do áudio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "__EXISTING_DELIVERY_URL__",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "__EXISTING_DELIVERY_SECRET__"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({number:$json.chatId,text:$json.replyText,mentioned:[$json.senderId].filter(j=>/^\\d{8,15}@s\\.whatsapp\\.net$/.test(j||''))}) }}",
        "options": {
          "timeout": 20000
        },
        "contentType": "json"
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
